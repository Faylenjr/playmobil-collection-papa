generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProductKind {
  SET
  FIGURE
  PART
  ACCESSORY
  MERCHANDISE
  CATALOGUE
  PROMOTIONAL_ITEM
  UNKNOWN
}

enum VariantKind {
  STANDARD
  MARKET
  BOX
  REISSUE
  PROMOTION
  EXCLUSIVE
  EDITION
  UNKNOWN
}

enum SourceKind {
  OFFICIAL
  COMMUNITY_DATABASE
  COMMUNITY_EDITORIAL
  RETAILER
  OTHER
}

enum ImportStatus {
  RUNNING
  SUCCEEDED
  PARTIAL
  FAILED
  CANCELLED
}

enum ConflictStatus {
  OPEN
  AUTO_RESOLVED
  MANUALLY_RESOLVED
  IGNORED
}

enum ReviewStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  IGNORED
}

enum CollectionCondition {
  SEALED
  NEW
  EXCELLENT
  GOOD
  FAIR
  POOR
  UNKNOWN
}

model Product {
  id                String           @id @default(uuid()) @db.Uuid
  canonicalKey      String           @unique @map("canonical_key")
  baseReference     String?          @map("base_reference")
  kind              ProductKind      @default(UNKNOWN)
  releaseYear       Int?             @map("release_year")
  discontinuedYear  Int?             @map("discontinued_year")
  name              String?
  description       String?
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  variants          ProductVariant[]
  translations      Translation[]
  themes            ProductTheme[]
  figures           ProductFigure[]
  parts             ProductPart[]

  @@index([baseReference])
  @@index([releaseYear])
  @@map("products")
}

model ProductVariant {
  id               String           @id @default(uuid()) @db.Uuid
  productId        String           @db.Uuid @map("product_id")
  canonicalKey     String           @unique @map("canonical_key")
  variantKind      VariantKind      @default(STANDARD) @map("variant_kind")
  variantLabel     String?          @map("variant_label")
  editionNumber    Int?             @map("edition_number")
  isCollectible    Boolean          @default(true) @map("is_collectible")
  isExclusive      Boolean?         @map("is_exclusive")
  isPromotion      Boolean?         @map("is_promotion")
  releaseDate      DateTime?        @db.Date @map("release_date")
  status           String?
  ageMin           Int?             @map("age_min")
  ageMax           Int?             @map("age_max")
  pieceCount       Int?             @map("piece_count")
  figureCount      Int?             @map("figure_count")
  listPrice        Decimal?         @db.Decimal(12, 2) @map("list_price")
  listPriceCurrency String?          @db.VarChar(3) @map("list_price_currency")
  firstSeenAt      DateTime         @default(now()) @map("first_seen_at")
  lastSeenAt       DateTime         @default(now()) @map("last_seen_at")
  lastCheckedAt    DateTime?        @map("last_checked_at")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  product          Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  references       ProductReference[]
  markets          VariantMarket[]
  media            MediaAsset[]
  instructions     Instruction[]
  collectionItems  CollectionItem[]
  wishlistItems    WishlistItem[]

  @@index([productId])
  @@map("product_variants")
}

model ProductReference {
  id               String          @id @default(uuid()) @db.Uuid
  variantId        String          @db.Uuid @map("variant_id")
  displayValue     String          @map("display_value")
  normalizedValue  String          @map("normalized_value")
  baseValue        String?         @map("base_value")
  suffix           String?
  isPrimary        Boolean         @default(false) @map("is_primary")
  sourceId         String?         @db.Uuid @map("source_id")
  variant          ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  source           Source?         @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@unique([variantId, normalizedValue])
  @@index([normalizedValue])
  @@index([baseValue])
  @@map("product_references")
}

model Translation {
  id          String   @id @default(uuid()) @db.Uuid
  productId   String   @db.Uuid @map("product_id")
  locale      String   @db.VarChar(12)
  name        String?
  description String?
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, locale])
  @@map("translations")
}

model Theme {
  id        String         @id @default(uuid()) @db.Uuid
  parentId  String?        @db.Uuid @map("parent_id")
  slug      String         @unique
  name      String
  parent    Theme?         @relation("ThemeTree", fields: [parentId], references: [id])
  children  Theme[]        @relation("ThemeTree")
  products  ProductTheme[]

  @@map("themes")
}

model ProductTheme {
  productId String  @db.Uuid @map("product_id")
  themeId   String  @db.Uuid @map("theme_id")
  isPrimary Boolean @default(false) @map("is_primary")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  theme     Theme   @relation(fields: [themeId], references: [id], onDelete: Cascade)

  @@id([productId, themeId])
  @@map("product_themes")
}

model Market {
  id       String          @id @default(uuid()) @db.Uuid
  code     String          @unique @db.VarChar(16)
  name     String
  variants VariantMarket[]

  @@map("markets")
}

model VariantMarket {
  variantId String         @db.Uuid @map("variant_id")
  marketId  String         @db.Uuid @map("market_id")
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  market    Market         @relation(fields: [marketId], references: [id], onDelete: Cascade)

  @@id([variantId, marketId])
  @@map("variant_markets")
}

model MediaAsset {
  id              String          @id @default(uuid()) @db.Uuid
  variantId       String          @db.Uuid @map("variant_id")
  sourceId        String          @db.Uuid @map("source_id")
  kind            String
  sourceUrl       String          @map("source_url")
  author          String?
  copyrightOwner  String?         @map("copyright_owner")
  license         String?
  canRehost       Boolean?        @map("can_rehost")
  canDisplay      Boolean?        @map("can_display")
  lastVerifiedAt  DateTime?       @map("last_verified_at")
  contentHash     String?         @map("content_hash")
  variant         ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  source          Source          @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@unique([variantId, sourceUrl])
  @@map("media_assets")
}

model Instruction {
  id              String          @id @default(uuid()) @db.Uuid
  variantId       String          @db.Uuid @map("variant_id")
  sourceId        String          @db.Uuid @map("source_id")
  locale          String?         @db.VarChar(12)
  documentUrl     String          @map("document_url")
  pageCount       Int?            @map("page_count")
  canRehost       Boolean?        @map("can_rehost")
  lastVerifiedAt  DateTime?       @map("last_verified_at")
  variant         ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  source          Source          @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@unique([variantId, documentUrl])
  @@map("instructions")
}

model Figure {
  id          String          @id @default(uuid()) @db.Uuid
  canonicalKey String         @unique @map("canonical_key")
  name        String?
  products    ProductFigure[]
  @@map("figures")
}

model ProductFigure {
  productId String  @db.Uuid @map("product_id")
  figureId  String  @db.Uuid @map("figure_id")
  quantity  Int     @default(1)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  figure    Figure  @relation(fields: [figureId], references: [id], onDelete: Cascade)
  @@id([productId, figureId])
  @@map("product_figures")
}

model Part {
  id           String        @id @default(uuid()) @db.Uuid
  partNumber   String        @unique @map("part_number")
  name         String?
  category     String?
  colour       String?
  products     ProductPart[]
  @@map("parts")
}

model ProductPart {
  productId String  @db.Uuid @map("product_id")
  partId    String  @db.Uuid @map("part_id")
  quantity  Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  part      Part    @relation(fields: [partId], references: [id], onDelete: Cascade)
  @@id([productId, partId])
  @@map("product_parts")
}

model Source {
  id              String             @id @default(uuid()) @db.Uuid
  key             String             @unique
  name            String
  baseUrl         String             @map("base_url")
  kind            SourceKind
  priority        Int                @default(100)
  termsUrl        String?            @map("terms_url")
  license         String?
  robotsCheckedAt DateTime?          @map("robots_checked_at")
  enabled         Boolean            @default(false)
  records         SourceRecord[]
  values          SourceValue[]
  references      ProductReference[]
  media           MediaAsset[]
  instructions    Instruction[]
  importRuns      ImportRun[]

  @@map("sources")
}

model SourceRecord {
  id              String         @id @default(uuid()) @db.Uuid
  sourceId        String         @db.Uuid @map("source_id")
  externalId      String         @map("external_id")
  sourceUrl       String         @map("source_url")
  recordType      String         @map("record_type")
  rawPayload      Json?          @map("raw_payload")
  contentHash     String         @map("content_hash")
  sourceUpdatedAt DateTime?      @map("source_updated_at")
  firstSeenAt     DateTime       @default(now()) @map("first_seen_at")
  lastSeenAt      DateTime       @default(now()) @map("last_seen_at")
  lastCheckedAt   DateTime       @default(now()) @map("last_checked_at")
  source          Source         @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  values          SourceValue[]

  @@unique([sourceId, externalId])
  @@index([contentHash])
  @@map("source_records")
}

model SourceValue {
  id              String       @id @default(uuid()) @db.Uuid
  sourceId        String       @db.Uuid @map("source_id")
  sourceRecordId  String       @db.Uuid @map("source_record_id")
  entityType      String       @map("entity_type")
  entityId        String       @db.Uuid @map("entity_id")
  field           String
  rawValue        Json         @map("raw_value")
  normalizedValue Json?        @map("normalized_value")
  confidence      Decimal      @default(0.5) @db.Decimal(4, 3)
  priority        Int
  isSelected      Boolean      @default(false) @map("is_selected")
  retrievedAt     DateTime     @default(now()) @map("retrieved_at")
  source          Source       @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  sourceRecord    SourceRecord @relation(fields: [sourceRecordId], references: [id], onDelete: Cascade)
  conflictValues  ConflictValue[]

  @@index([entityType, entityId, field])
  @@map("source_values")
}

model Conflict {
  id              String          @id @default(uuid()) @db.Uuid
  entityType      String          @map("entity_type")
  entityId        String          @db.Uuid @map("entity_id")
  field           String
  status          ConflictStatus  @default(OPEN)
  selectedValueId String?         @db.Uuid @map("selected_value_id")
  resolutionNote  String?         @map("resolution_note")
  createdAt       DateTime        @default(now()) @map("created_at")
  resolvedAt      DateTime?       @map("resolved_at")
  values          ConflictValue[]

  @@index([status])
  @@map("conflicts")
}

model ConflictValue {
  conflictId  String      @db.Uuid @map("conflict_id")
  sourceValueId String    @db.Uuid @map("source_value_id")
  conflict    Conflict    @relation(fields: [conflictId], references: [id], onDelete: Cascade)
  sourceValue SourceValue @relation(fields: [sourceValueId], references: [id], onDelete: Cascade)
  @@id([conflictId, sourceValueId])
  @@map("conflict_values")
}

model ReviewTask {
  id          String       @id @default(uuid()) @db.Uuid
  kind        String
  entityType  String       @map("entity_type")
  entityId    String?      @db.Uuid @map("entity_id")
  reason      String
  payload     Json?
  status      ReviewStatus @default(OPEN)
  createdAt   DateTime     @default(now()) @map("created_at")
  resolvedAt  DateTime?    @map("resolved_at")
  @@index([status, kind])
  @@map("review_tasks")
}

model ImportRun {
  id             String       @id @default(uuid()) @db.Uuid
  sourceId       String       @db.Uuid @map("source_id")
  mode           String
  status         ImportStatus @default(RUNNING)
  startedAt      DateTime     @default(now()) @map("started_at")
  finishedAt     DateTime?    @map("finished_at")
  scanned        Int          @default(0)
  created        Int          @default(0)
  updated        Int          @default(0)
  unchanged      Int          @default(0)
  errors         Int          @default(0)
  conflicts      Int          @default(0)
  inaccessible   Int          @default(0)
  cursor         Json?
  errorSummary   Json?        @map("error_summary")
  source         Source       @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@index([sourceId, startedAt])
  @@map("import_runs")
}

model User {
  id          String       @id @default(uuid()) @db.Uuid
  email       String       @unique
  displayName String?      @map("display_name")
  createdAt   DateTime     @default(now()) @map("created_at")
  collections Collection[]
  wishlists    Wishlist[]
  @@map("users")
}

model Collection {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid @map("user_id")
  name      String
  isPublic  Boolean          @default(false) @map("is_public")
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CollectionItem[]
  @@map("collections")
}

model CollectionItem {
  id             String              @id @default(uuid()) @db.Uuid
  collectionId   String              @db.Uuid @map("collection_id")
  variantId      String              @db.Uuid @map("variant_id")
  quantity       Int                 @default(1)
  condition      CollectionCondition @default(UNKNOWN)
  isComplete     Boolean?            @map("is_complete")
  hasBox         Boolean?            @map("has_box")
  boxCondition   CollectionCondition? @map("box_condition")
  hasInstructions Boolean?           @map("has_instructions")
  purchaseDate   DateTime?           @db.Date @map("purchase_date")
  purchasePrice  Decimal?            @db.Decimal(12, 2) @map("purchase_price")
  currency       String?             @db.VarChar(3)
  notes          String?
  collection     Collection          @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  variant        ProductVariant      @relation(fields: [variantId], references: [id], onDelete: Restrict)
  @@unique([collectionId, variantId])
  @@map("collection_items")
}

model Wishlist {
  id        String         @id @default(uuid()) @db.Uuid
  userId    String         @db.Uuid @map("user_id")
  name      String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     WishlistItem[]
  @@map("wishlists")
}

model WishlistItem {
  id         String         @id @default(uuid()) @db.Uuid
  wishlistId String         @db.Uuid @map("wishlist_id")
  variantId  String         @db.Uuid @map("variant_id")
  priority   Int            @default(0)
  notes      String?
  wishlist   Wishlist       @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  variant    ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  @@unique([wishlistId, variantId])
  @@map("wishlist_items")
}

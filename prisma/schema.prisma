generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  runtime  = "workerd"
}

generator nodeClient {
  provider = "prisma-client"
  output   = "../generated/prisma-node"
  runtime  = "nodejs"
}

datasource db {
  provider = "postgresql"
}

enum ProductKind {
  SET
  FIGURE
  PART
  ACCESSORY
  MERCHANDISE
  CATALOGUE
  PROMOTIONAL_ITEM
  UNKNOWN
}

enum VariantKind {
  STANDARD
  MARKET
  BOX
  REISSUE
  PROMOTION
  EXCLUSIVE
  EDITION
  UNKNOWN
}

enum SourceKind {
  OFFICIAL
  COMMUNITY_DATABASE
  COMMUNITY_EDITORIAL
  RETAILER
  OTHER
}

enum ImportStatus {
  RUNNING
  SUCCEEDED
  PARTIAL
  FAILED
  CANCELLED
}

enum ConflictStatus {
  OPEN
  AUTO_RESOLVED
  MANUALLY_RESOLVED
  IGNORED
}

enum ReviewStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  IGNORED
}

enum ReferenceIdentityClass {
  ASSIGNED
  PLACEHOLDER
  REUSED
  AMBIGUOUS
}

enum CollectionCondition {
  SEALED
  NEW
  EXCELLENT
  GOOD
  FAIR
  POOR
  UNKNOWN
}

enum RangeKind {
  LINE
  SERIES
  LICENSE
  SUBLINE
}

enum WavePrecision {
  MONTH
  RANGE
  CAMPAIGN
}

enum MarketRelationKind {
  PRESENCE
  MARKET_EDITION
  ATTESTED_EXCLUSIVE
}

enum CommercialContextKind {
  RETAILER_DISTRIBUTOR
  MAGAZINE_PUBLICATION
  EVENT_VENUE
  ORGANIZATION_ASSOCIATION
  PROMOTIONAL_CAMPAIGN
  BRAND_LICENSE_PARTNER
  OTHER_DOCUMENTED_CONTEXT
}

enum RetailerType {
  SHOP
  MARKETPLACE
  PRIVATE_LISTING
  MANUFACTURER
}

enum OfferCondition {
  NEW
  USED
  SEALED
  UNKNOWN
}

enum OfferAvailability {
  AVAILABLE
  OUT_OF_STOCK
  ENDED
  UNKNOWN
}

enum ProductIdentifierType {
  EAN
  GTIN
  UPC
  MPN
  OFFICIAL_SKU
}

enum IdentifierConfidenceStatus {
  SOURCE_OBSERVED
  CORROBORATED
  OFFICIAL_CONFIRMED
  CONFLICTING
  REJECTED
}

enum ExternalCandidateStatus {
  DISCOVERED
  CORROBORATED
  OFFICIAL_CONFIRMED
  CONFLICTING
  REJECTED
  IMPORTED
}

model Product {
  id               String            @id @default(uuid()) @db.Uuid
  canonicalKey     String            @unique @map("canonical_key")
  baseReference    String?           @map("base_reference")
  kind             ProductKind       @default(UNKNOWN)
  releaseYear      Int?              @map("release_year")
  discontinuedYear Int?              @map("discontinued_year")
  name             String?
  description      String?
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  variants         ProductVariant[]
  translations     Translation[]
  themes           ProductTheme[]
  figures          ProductFigure[]
  parts            ProductPart[]
  rangeMemberships RangeMembership[]
  releaseWaveItems ReleaseWaveItem[]
  offers           Offer[]
  identifiers      ProductIdentifier[]
  importedCandidates ExternalCandidate[]

  @@index([baseReference])
  @@index([releaseYear])
  @@map("products")
}

model ProductVariant {
  id                     String                      @id @default(uuid()) @db.Uuid
  productId              String                      @map("product_id") @db.Uuid
  canonicalKey           String                      @unique @map("canonical_key")
  variantKind            VariantKind                 @default(STANDARD) @map("variant_kind")
  variantLabel           String?                     @map("variant_label")
  editionNumber          Int?                        @map("edition_number")
  name                   String?
  description            String?
  releaseYear            Int?                        @map("release_year")
  discontinuedYear       Int?                        @map("discontinued_year")
  format                 String?
  isCollectible          Boolean                     @default(true) @map("is_collectible")
  isExclusive            Boolean?                    @map("is_exclusive")
  isPromotion            Boolean?                    @map("is_promotion")
  releaseDate            DateTime?                   @map("release_date") @db.Date
  status                 String?
  ageMin                 Int?                        @map("age_min")
  ageMax                 Int?                        @map("age_max")
  pieceCount             Int?                        @map("piece_count")
  figureCount            Int?                        @map("figure_count")
  widthMm                Decimal?                    @map("width_mm") @db.Decimal(10, 2)
  heightMm               Decimal?                    @map("height_mm") @db.Decimal(10, 2)
  depthMm                Decimal?                    @map("depth_mm") @db.Decimal(10, 2)
  weightGrams            Decimal?                    @map("weight_grams") @db.Decimal(10, 2)
  partsInventoryComplete Boolean?                    @map("parts_inventory_complete")
  listPrice              Decimal?                    @map("list_price") @db.Decimal(12, 2)
  listPriceCurrency      String?                     @map("list_price_currency") @db.VarChar(3)
  firstSeenAt            DateTime                    @default(now()) @map("first_seen_at")
  lastSeenAt             DateTime                    @default(now()) @map("last_seen_at")
  lastCheckedAt          DateTime?                   @map("last_checked_at")
  createdAt              DateTime                    @default(now()) @map("created_at")
  updatedAt              DateTime                    @updatedAt @map("updated_at")
  product                Product                     @relation(fields: [productId], references: [id], onDelete: Cascade)
  references             ProductReference[]
  translations           VariantTranslation[]
  themes                 VariantTheme[]
  markets                VariantMarket[]
  media                  MediaAsset[]
  instructions           Instruction[]
  figures                VariantFigure[]
  parts                  VariantPart[]
  collectionItems        CollectionItem[]
  wishlistItems          WishlistItem[]
  sourceRecords          SourceRecord[]
  categoryMemberships    VariantCategoryMembership[]
  marketEvidence         MarketEvidence[]
  commercialContextEvidence CommercialContextEvidence[]
  offers                 Offer[]
  listPriceObservations  ListPriceObservation[]
  identifiers            ProductIdentifier[]

  @@index([productId])
  @@index([releaseYear])
  @@map("product_variants")
}

model ProductReference {
  id              String                 @id @default(uuid()) @db.Uuid
  variantId       String                 @map("variant_id") @db.Uuid
  displayValue    String                 @map("display_value")
  normalizedValue String                 @map("normalized_value")
  baseValue       String?                @map("base_value")
  suffix          String?
  isPrimary       Boolean                @default(false) @map("is_primary")
  sourceId        String?                @map("source_id") @db.Uuid
  identityClass   ReferenceIdentityClass @default(ASSIGNED) @map("identity_class")
  identityReason  String?                @map("identity_reason")
  variant         ProductVariant         @relation(fields: [variantId], references: [id], onDelete: Cascade)
  source          Source?                @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@unique([variantId, normalizedValue])
  @@index([normalizedValue])
  @@index([baseValue])
  @@index([identityClass])
  @@map("product_references")
}

model Translation {
  id          String  @id @default(uuid()) @db.Uuid
  productId   String  @map("product_id") @db.Uuid
  locale      String  @db.VarChar(12)
  name        String?
  description String?
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, locale])
  @@map("translations")
}

model VariantTranslation {
  id          String         @id @default(uuid()) @db.Uuid
  variantId   String         @map("variant_id") @db.Uuid
  locale      String         @db.VarChar(12)
  name        String?
  description String?
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([variantId, locale])
  @@map("variant_translations")
}

model Theme {
  id       String         @id @default(uuid()) @db.Uuid
  parentId String?        @map("parent_id") @db.Uuid
  slug     String         @unique
  name     String
  parent   Theme?         @relation("ThemeTree", fields: [parentId], references: [id])
  children Theme[]        @relation("ThemeTree")
  products ProductTheme[]
  variants VariantTheme[]

  @@map("themes")
}

model VariantTheme {
  variantId String         @map("variant_id") @db.Uuid
  themeId   String         @map("theme_id") @db.Uuid
  isPrimary Boolean        @default(false) @map("is_primary")
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  theme     Theme          @relation(fields: [themeId], references: [id], onDelete: Cascade)

  @@id([variantId, themeId])
  @@map("variant_themes")
}

model ProductTheme {
  productId String  @map("product_id") @db.Uuid
  themeId   String  @map("theme_id") @db.Uuid
  isPrimary Boolean @default(false) @map("is_primary")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  theme     Theme   @relation(fields: [themeId], references: [id], onDelete: Cascade)

  @@id([productId, themeId])
  @@map("product_themes")
}

model Market {
  id            String                 @id @default(uuid()) @db.Uuid
  code          String                 @unique @db.VarChar(16)
  name          String
  variants      VariantMarket[]
  productRanges ProductRange[]
  releaseWaves  ReleaseWave[]
  evidence      MarketEvidence[]
  listPrices    ListPriceObservation[]
  retailers     Retailer[]
  identifiers   ProductIdentifier[]

  @@map("markets")
}

model ProductRange {
  id            String            @id @default(uuid()) @db.Uuid
  slug          String            @unique
  canonicalName String            @map("canonical_name")
  kind          RangeKind
  description   String?
  startYear     Int?              @map("start_year")
  endYear       Int?              @map("end_year")
  marketId      String?           @map("market_id") @db.Uuid
  sourceId      String            @map("source_id") @db.Uuid
  sourceUrl     String            @map("source_url")
  observedAt    DateTime          @map("observed_at")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")
  market        Market?           @relation(fields: [marketId], references: [id], onDelete: SetNull)
  source        Source            @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  memberships   RangeMembership[]
  waves         ReleaseWave[]

  @@index([marketId])
  @@map("product_ranges")
}

model RangeMembership {
  rangeId           String       @map("range_id") @db.Uuid
  productId         String       @map("product_id") @db.Uuid
  observedReference String       @map("observed_reference")
  sourceUrl         String       @map("source_url")
  confidence        Decimal      @default(1) @db.Decimal(4, 3)
  observedAt        DateTime     @map("observed_at")
  range             ProductRange @relation(fields: [rangeId], references: [id], onDelete: Cascade)
  product           Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([rangeId, productId])
  @@index([productId])
  @@map("range_memberships")
}

model ReleaseWave {
  id           String            @id @default(uuid()) @db.Uuid
  slug         String            @unique
  name         String
  releaseYear  Int               @map("release_year")
  periodStart  DateTime          @map("period_start") @db.Date
  periodEnd    DateTime          @map("period_end") @db.Date
  precision    WavePrecision
  marketId     String            @map("market_id") @db.Uuid
  rangeId      String?           @map("range_id") @db.Uuid
  sourceId     String            @map("source_id") @db.Uuid
  sourceUrl    String            @map("source_url")
  documentHash String?           @map("document_hash")
  observedAt   DateTime          @map("observed_at")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")
  market       Market            @relation(fields: [marketId], references: [id], onDelete: Restrict)
  range        ProductRange?     @relation(fields: [rangeId], references: [id], onDelete: SetNull)
  source       Source            @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  items        ReleaseWaveItem[]

  @@index([releaseYear, periodStart])
  @@map("release_waves")
}

model ReleaseWaveItem {
  releaseWaveId     String      @map("release_wave_id") @db.Uuid
  productId         String      @map("product_id") @db.Uuid
  observedReference String      @map("observed_reference")
  officialOrder     Int         @map("official_order")
  manifestOrder     Int         @map("manifest_order")
  matchStatus       String      @map("match_status")
  observedAt        DateTime    @map("observed_at")
  releaseWave       ReleaseWave @relation(fields: [releaseWaveId], references: [id], onDelete: Cascade)
  product           Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([releaseWaveId, productId])
  @@unique([releaseWaveId, observedReference])
  @@index([productId])
  @@map("release_wave_items")
}

model CollectorCategory {
  id          String                      @id @default(uuid()) @db.Uuid
  slug        String                      @unique
  name        String
  description String?
  ruleVersion String                      @map("rule_version")
  createdAt   DateTime                    @default(now()) @map("created_at")
  updatedAt   DateTime                    @updatedAt @map("updated_at")
  memberships VariantCategoryMembership[]

  @@map("collector_categories")
}

model VariantCategoryMembership {
  categoryId String            @map("category_id") @db.Uuid
  variantId  String            @map("variant_id") @db.Uuid
  sourceId   String?           @map("source_id") @db.Uuid
  sourceUrl  String?           @map("source_url")
  evidence   String
  observedAt DateTime          @map("observed_at")
  category   CollectorCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  variant    ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Cascade)
  source     Source?           @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@id([categoryId, variantId])
  @@index([variantId])
  @@map("variant_category_memberships")
}

model MarketEvidence {
  id         String             @id @default(uuid()) @db.Uuid
  variantId  String             @map("variant_id") @db.Uuid
  marketId   String             @map("market_id") @db.Uuid
  kind       MarketRelationKind
  sourceId   String?            @map("source_id") @db.Uuid
  sourceUrl  String?            @map("source_url")
  evidence   String
  confidence Decimal            @default(0.8) @db.Decimal(4, 3)
  observedAt DateTime           @map("observed_at")
  variant    ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  market     Market             @relation(fields: [marketId], references: [id], onDelete: Cascade)
  source     Source?            @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@unique([variantId, marketId, kind])
  @@index([marketId, kind])
  @@map("market_evidence")
}

model CommercialContext {
  id             String                       @id @default(uuid()) @db.Uuid
  kind           CommercialContextKind
  canonicalName  String                       @map("canonical_name")
  normalizedName String                       @map("normalized_name")
  createdAt      DateTime                     @default(now()) @map("created_at")
  updatedAt      DateTime                     @updatedAt @map("updated_at")
  evidence       CommercialContextEvidence[]

  @@unique([kind, normalizedName])
  @@index([kind, canonicalName])
  @@map("commercial_contexts")
}

model CommercialContextEvidence {
  id             String            @id @default(uuid()) @db.Uuid
  contextId      String            @map("context_id") @db.Uuid
  variantId      String            @map("variant_id") @db.Uuid
  sourceId       String            @map("source_id") @db.Uuid
  sourceRecordId String            @map("source_record_id") @db.Uuid
  rawValue       String            @map("raw_value")
  sourceUrl      String            @map("source_url")
  reason         String
  observedAt     DateTime          @map("observed_at")
  createdAt      DateTime          @default(now()) @map("created_at")
  context        CommercialContext @relation(fields: [contextId], references: [id], onDelete: Restrict)
  variant        ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Cascade)
  source         Source            @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  sourceRecord   SourceRecord      @relation(fields: [sourceRecordId], references: [id], onDelete: Restrict)

  @@unique([sourceRecordId])
  @@index([variantId])
  @@map("commercial_context_evidence")
}

model VariantMarket {
  variantId String         @map("variant_id") @db.Uuid
  marketId  String         @map("market_id") @db.Uuid
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  market    Market         @relation(fields: [marketId], references: [id], onDelete: Cascade)

  @@id([variantId, marketId])
  @@map("variant_markets")
}

model MediaAsset {
  id             String         @id @default(uuid()) @db.Uuid
  variantId      String         @map("variant_id") @db.Uuid
  sourceId       String         @map("source_id") @db.Uuid
  kind           String
  sourceUrl      String         @map("source_url")
  author         String?
  copyrightOwner String?        @map("copyright_owner")
  license        String?
  canRehost      Boolean?       @map("can_rehost")
  canDisplay     Boolean?       @map("can_display")
  lastVerifiedAt DateTime?      @map("last_verified_at")
  contentHash    String?        @map("content_hash")
  variant        ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  source         Source         @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@unique([variantId, sourceUrl])
  @@map("media_assets")
}

model Instruction {
  id             String         @id @default(uuid()) @db.Uuid
  variantId      String         @map("variant_id") @db.Uuid
  sourceId       String         @map("source_id") @db.Uuid
  locale         String?        @db.VarChar(12)
  documentUrl    String         @map("document_url")
  pageCount      Int?           @map("page_count")
  canRehost      Boolean?       @map("can_rehost")
  lastVerifiedAt DateTime?      @map("last_verified_at")
  variant        ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  source         Source         @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@unique([variantId, documentUrl])
  @@map("instructions")
}

model Figure {
  id           String          @id @default(uuid()) @db.Uuid
  canonicalKey String          @unique @map("canonical_key")
  name         String?
  products     ProductFigure[]
  variants     VariantFigure[]

  @@map("figures")
}

model VariantFigure {
  variantId String         @map("variant_id") @db.Uuid
  figureId  String         @map("figure_id") @db.Uuid
  quantity  Int?
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  figure    Figure         @relation(fields: [figureId], references: [id], onDelete: Cascade)

  @@id([variantId, figureId])
  @@map("variant_figures")
}

model ProductFigure {
  productId String  @map("product_id") @db.Uuid
  figureId  String  @map("figure_id") @db.Uuid
  quantity  Int     @default(1)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  figure    Figure  @relation(fields: [figureId], references: [id], onDelete: Cascade)

  @@id([productId, figureId])
  @@map("product_figures")
}

model Part {
  id         String        @id @default(uuid()) @db.Uuid
  partNumber String        @unique @map("part_number")
  name       String?
  category   String?
  colour     String?
  products   ProductPart[]
  variants   VariantPart[]

  @@map("parts")
}

model VariantPart {
  variantId String         @map("variant_id") @db.Uuid
  partId    String         @map("part_id") @db.Uuid
  quantity  Int?
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  part      Part           @relation(fields: [partId], references: [id], onDelete: Cascade)

  @@id([variantId, partId])
  @@map("variant_parts")
}

model ProductPart {
  productId String  @map("product_id") @db.Uuid
  partId    String  @map("part_id") @db.Uuid
  quantity  Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  part      Part    @relation(fields: [partId], references: [id], onDelete: Cascade)

  @@id([productId, partId])
  @@map("product_parts")
}

model Source {
  id                  String                      @id @default(uuid()) @db.Uuid
  key                 String                      @unique
  name                String
  baseUrl             String                      @map("base_url")
  kind                SourceKind
  priority            Int                         @default(100)
  termsUrl            String?                     @map("terms_url")
  license             String?
  robotsCheckedAt     DateTime?                   @map("robots_checked_at")
  enabled             Boolean                     @default(false)
  records             SourceRecord[]
  values              SourceValue[]
  references          ProductReference[]
  media               MediaAsset[]
  instructions        Instruction[]
  importRuns          ImportRun[]
  productRanges       ProductRange[]
  releaseWaves        ReleaseWave[]
  categoryMemberships VariantCategoryMembership[]
  marketEvidence      MarketEvidence[]
  commercialContextEvidence CommercialContextEvidence[]
  retailers           Retailer[]
  listPrices          ListPriceObservation[]
  productIdentifiers  ProductIdentifier[]
  candidateObservations ExternalCandidateObservation[]

  @@map("sources")
}

model ProductIdentifier {
  id              String                     @id @default(uuid()) @db.Uuid
  observationKey  String                     @unique @map("observation_key")
  productId       String?                    @map("product_id") @db.Uuid
  variantId       String?                    @map("variant_id") @db.Uuid
  type            ProductIdentifierType
  rawValue        String                     @map("raw_value")
  normalizedValue String                     @map("normalized_value")
  sourceId        String                     @map("source_id") @db.Uuid
  marketId        String?                    @map("market_id") @db.Uuid
  sourceUrl       String                     @map("source_url")
  observedAt      DateTime                   @map("observed_at")
  confidence      IdentifierConfidenceStatus @default(SOURCE_OBSERVED)
  createdAt       DateTime                   @default(now()) @map("created_at")
  product         Product?                   @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant         ProductVariant?            @relation(fields: [variantId], references: [id], onDelete: Cascade)
  source          Source                     @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  market          Market?                    @relation(fields: [marketId], references: [id], onDelete: SetNull)

  @@index([type, normalizedValue])
  @@index([productId])
  @@index([variantId])
  @@map("product_identifiers")
}

model ExternalCandidate {
  id                  String                  @id @default(uuid()) @db.Uuid
  displayReference    String                  @map("display_reference")
  normalizedReference String                  @unique @map("normalized_reference")
  status              ExternalCandidateStatus @default(DISCOVERED)
  conflictReason      String?                 @map("conflict_reason")
  importedProductId   String?                 @map("imported_product_id") @db.Uuid
  firstObservedAt     DateTime                @map("first_observed_at")
  lastObservedAt      DateTime                @map("last_observed_at")
  createdAt           DateTime                @default(now()) @map("created_at")
  updatedAt           DateTime                @updatedAt @map("updated_at")
  importedProduct     Product?                @relation(fields: [importedProductId], references: [id], onDelete: SetNull)
  observations        ExternalCandidateObservation[]

  @@index([status, lastObservedAt(sort: Desc)])
  @@map("external_candidates")
}

model ExternalCandidateObservation {
  id              String            @id @default(uuid()) @db.Uuid
  observationKey  String            @unique @map("observation_key")
  candidateId     String            @map("candidate_id") @db.Uuid
  sourceId        String            @map("source_id") @db.Uuid
  sourceUrl       String            @map("source_url")
  observedName    String?           @map("observed_name")
  announcedYear   Int?              @map("announced_year")
  announcedMonth  String?           @map("announced_month")
  firstObservedAt DateTime          @map("first_observed_at")
  lastObservedAt  DateTime          @map("last_observed_at")
  candidate       ExternalCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  source          Source            @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@index([candidateId, sourceId])
  @@map("external_candidate_observations")
}

model SourceRecord {
  id                String                   @id @default(uuid()) @db.Uuid
  sourceId          String                   @map("source_id") @db.Uuid
  variantId         String?                  @map("variant_id") @db.Uuid
  externalId        String                   @map("external_id")
  sourceUrl         String                   @map("source_url")
  recordType        String                   @map("record_type")
  rawPayload        Json?                    @map("raw_payload")
  contentHash       String                   @map("content_hash")
  sourceUpdatedAt   DateTime?                @map("source_updated_at")
  firstSeenAt       DateTime                 @default(now()) @map("first_seen_at")
  lastSeenAt        DateTime                 @default(now()) @map("last_seen_at")
  lastCheckedAt     DateTime                 @default(now()) @map("last_checked_at")
  source            Source                   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  variant           ProductVariant?          @relation(fields: [variantId], references: [id], onDelete: SetNull)
  values            SourceValue[]
  mediaObservations SourceMediaObservation[]
  commercialContextEvidence CommercialContextEvidence[]

  @@unique([sourceId, externalId])
  @@index([contentHash])
  @@index([variantId])
  @@map("source_records")
}

model SourceMediaObservation {
  id              String       @id @default(uuid()) @db.Uuid
  sourceRecordId  String       @map("source_record_id") @db.Uuid
  sourceUrl       String       @map("source_url")
  kind            String
  observedAt      DateTime     @default(now()) @map("observed_at")
  pageContentHash String?      @map("page_content_hash")
  sourceRecord    SourceRecord @relation(fields: [sourceRecordId], references: [id], onDelete: Cascade)

  @@unique([sourceRecordId, sourceUrl, kind])
  @@index([sourceUrl])
  @@map("source_media_observations")
}

model SourceValue {
  id              String          @id @default(uuid()) @db.Uuid
  sourceId        String          @map("source_id") @db.Uuid
  sourceRecordId  String          @map("source_record_id") @db.Uuid
  entityType      String          @map("entity_type")
  entityId        String          @map("entity_id") @db.Uuid
  field           String
  rawValue        Json            @map("raw_value")
  normalizedValue Json?           @map("normalized_value")
  confidence      Decimal         @default(0.5) @db.Decimal(4, 3)
  priority        Int
  isSelected      Boolean         @default(false) @map("is_selected")
  retrievedAt     DateTime        @default(now()) @map("retrieved_at")
  source          Source          @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  sourceRecord    SourceRecord    @relation(fields: [sourceRecordId], references: [id], onDelete: Cascade)
  conflictValues  ConflictValue[]

  @@index([entityType, entityId, field])
  @@map("source_values")
}

model Conflict {
  id              String          @id @default(uuid()) @db.Uuid
  entityType      String          @map("entity_type")
  entityId        String          @map("entity_id") @db.Uuid
  field           String
  status          ConflictStatus  @default(OPEN)
  selectedValueId String?         @map("selected_value_id") @db.Uuid
  resolutionNote  String?         @map("resolution_note")
  createdAt       DateTime        @default(now()) @map("created_at")
  resolvedAt      DateTime?       @map("resolved_at")
  values          ConflictValue[]

  @@index([status])
  @@map("conflicts")
}

model ConflictValue {
  conflictId    String      @map("conflict_id") @db.Uuid
  sourceValueId String      @map("source_value_id") @db.Uuid
  conflict      Conflict    @relation(fields: [conflictId], references: [id], onDelete: Cascade)
  sourceValue   SourceValue @relation(fields: [sourceValueId], references: [id], onDelete: Cascade)

  @@id([conflictId, sourceValueId])
  @@map("conflict_values")
}

model ReviewTask {
  id             String       @id @default(uuid()) @db.Uuid
  kind           String
  entityType     String       @map("entity_type")
  entityId       String?      @map("entity_id") @db.Uuid
  reason         String
  payload        Json?
  status         ReviewStatus @default(OPEN)
  createdAt      DateTime     @default(now()) @map("created_at")
  resolvedAt     DateTime?    @map("resolved_at")
  resolutionNote String?      @map("resolution_note")

  @@index([status, kind])
  @@map("review_tasks")
}

model ImportRun {
  id           String       @id @default(uuid()) @db.Uuid
  sourceId     String       @map("source_id") @db.Uuid
  mode         String
  status       ImportStatus @default(RUNNING)
  startedAt    DateTime     @default(now()) @map("started_at")
  finishedAt   DateTime?    @map("finished_at")
  scanned      Int          @default(0)
  created      Int          @default(0)
  updated      Int          @default(0)
  unchanged    Int          @default(0)
  errors       Int          @default(0)
  conflicts    Int          @default(0)
  inaccessible Int          @default(0)
  cursor       Json?
  errorSummary Json?        @map("error_summary")
  source       Source       @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@index([sourceId, startedAt])
  @@map("import_runs")
}

model Retailer {
  id          String       @id @default(uuid()) @db.Uuid
  slug        String       @unique
  name        String
  type        RetailerType
  countryCode String?      @map("country_code") @db.VarChar(2)
  baseUrl     String       @map("base_url")
  sourceId    String?      @map("source_id") @db.Uuid
  marketId    String?      @map("market_id") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  source      Source?      @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  market      Market?      @relation(fields: [marketId], references: [id], onDelete: SetNull)
  offers      Offer[]

  @@index([marketId])
  @@map("retailers")
}

model Offer {
  id              String             @id @default(uuid()) @db.Uuid
  retailerId      String             @map("retailer_id") @db.Uuid
  productId       String?            @map("product_id") @db.Uuid
  variantId       String?            @map("variant_id") @db.Uuid
  externalId      String             @map("external_id")
  url             String
  condition       OfferCondition     @default(UNKNOWN)
  availability    OfferAvailability  @default(UNKNOWN)
  matchConfidence Decimal?           @map("match_confidence") @db.Decimal(4, 3)
  matchEvidence   String?            @map("match_evidence")
  firstObservedAt DateTime           @default(now()) @map("first_observed_at")
  lastObservedAt  DateTime           @map("last_observed_at")
  retailer        Retailer           @relation(fields: [retailerId], references: [id], onDelete: Cascade)
  product         Product?           @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant         ProductVariant?    @relation(fields: [variantId], references: [id], onDelete: Cascade)
  observations    PriceObservation[]

  @@unique([retailerId, externalId])
  @@index([productId, availability])
  @@index([variantId, availability])
  @@map("offers")
}

model PriceObservation {
  id            String            @id @default(uuid()) @db.Uuid
  offerId       String            @map("offer_id") @db.Uuid
  itemPrice     Decimal           @map("item_price") @db.Decimal(12, 2)
  shippingPrice Decimal?          @map("shipping_price") @db.Decimal(12, 2)
  totalPrice    Decimal?          @map("total_price") @db.Decimal(12, 2)
  currency      String            @db.VarChar(3)
  availability  OfferAvailability
  observedAt    DateTime          @map("observed_at")
  offer         Offer             @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@index([offerId, observedAt(sort: Desc)])
  @@map("price_observations")
}

model ListPriceObservation {
  id         String         @id @default(uuid()) @db.Uuid
  variantId  String         @map("variant_id") @db.Uuid
  marketId   String         @map("market_id") @db.Uuid
  sourceId   String         @map("source_id") @db.Uuid
  amount     Decimal        @db.Decimal(12, 2)
  currency   String         @db.VarChar(3)
  sourceUrl  String         @map("source_url")
  validFrom  DateTime?      @map("valid_from") @db.Date
  validUntil DateTime?      @map("valid_until") @db.Date
  observedAt DateTime       @map("observed_at")
  variant    ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  market     Market         @relation(fields: [marketId], references: [id], onDelete: Restrict)
  source     Source         @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@index([variantId, marketId, observedAt(sort: Desc)])
  @@map("list_price_observations")
}

model User {
  id          String       @id @default(uuid()) @db.Uuid
  email       String       @unique
  displayName String?      @map("display_name")
  createdAt   DateTime     @default(now()) @map("created_at")
  collections Collection[]
  wishlists   Wishlist[]

  @@map("users")
}

model Collection {
  id       String           @id @default(uuid()) @db.Uuid
  userId   String           @map("user_id") @db.Uuid
  name     String
  isPublic Boolean          @default(false) @map("is_public")
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  items    CollectionItem[]

  @@map("collections")
}

model CollectionItem {
  id              String               @id @default(uuid()) @db.Uuid
  collectionId    String               @map("collection_id") @db.Uuid
  variantId       String               @map("variant_id") @db.Uuid
  quantity        Int                  @default(1)
  condition       CollectionCondition  @default(UNKNOWN)
  isComplete      Boolean?             @map("is_complete")
  hasBox          Boolean?             @map("has_box")
  boxCondition    CollectionCondition? @map("box_condition")
  hasInstructions Boolean?             @map("has_instructions")
  purchaseDate    DateTime?            @map("purchase_date") @db.Date
  purchasePrice   Decimal?             @map("purchase_price") @db.Decimal(12, 2)
  currency        String?              @db.VarChar(3)
  notes           String?
  collection      Collection           @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  variant         ProductVariant       @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([collectionId, variantId])
  @@map("collection_items")
}

model Wishlist {
  id     String         @id @default(uuid()) @db.Uuid
  userId String         @map("user_id") @db.Uuid
  name   String
  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items  WishlistItem[]

  @@map("wishlists")
}

model WishlistItem {
  id         String         @id @default(uuid()) @db.Uuid
  wishlistId String         @map("wishlist_id") @db.Uuid
  variantId  String         @map("variant_id") @db.Uuid
  priority   Int            @default(0)
  notes      String?
  wishlist   Wishlist       @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  variant    ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([wishlistId, variantId])
  @@map("wishlist_items")
}

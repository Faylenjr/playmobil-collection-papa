index 0000000..6ba2906
--- /dev/null
+++ b/src/report/anomalies.ts
@@ -0,0 +1,63 @@
+import type { PrismaClient } from "../../generated/prisma/client.js";
+import { buildCoverageReport } from "./coverage.js";
+
+export async function buildAnomalyReport(db: PrismaClient) {
+  const [references, missingCore, suspiciousYears, conflicts, reviews, failedRuns] = await Promise.all([
+    db.productReference.findMany({ select: { normalizedValue: true, variantId: true, displayValue: true } }),
+    db.productVariant.findMany({
+      where: { OR: [{ references: { none: {} } }, { name: null }] },
+      select: { id: true, canonicalKey: true, name: true, references: { select: { displayValue: true } } },
+    }),
+    db.productVariant.findMany({
+      where: { OR: [{ releaseYear: { lt: 1974 } }, { releaseYear: { gt: new Date().getUTCFullYear() + 1 } }, { discontinuedYear: { lt: 1974 } }] },
+      select: { id: true, canonicalKey: true, releaseYear: true, discontinuedYear: true },
+    }),
+    db.conflict.findMany({
+      where: { status: "OPEN" },
+      select: { id: true, entityType: true, entityId: true, field: true, createdAt: true, values: { select: { sourceValue: { select: { normalizedValue: true, source: { select: { key: true } } } } } } },
+    }),
+    db.reviewTask.findMany({ where: { status: "OPEN" }, select: { id: true, kind: true, entityType: true, entityId: true, reason: true, payload: true, createdAt: true } }),
+    db.importRun.findMany({ where: { OR: [{ errors: { gt: 0 } }, { inaccessible: { gt: 0 } }, { status: { in: ["FAILED", "PARTIAL"] } }] }, orderBy: { startedAt: "asc" } }),
+  ]);
+
+  const byReference = new Map<string, Array<{ variantId: string; displayValue: string }>>();
+  for (const reference of references) {
+    const values = byReference.get(reference.normalizedValue) ?? [];
+    values.push({ variantId: reference.variantId, displayValue: reference.displayValue });
+    byReference.set(reference.normalizedValue, values);
+  }
+  const repeatedReferences = [...byReference.entries()]
+    .filter(([, values]) => new Set(values.map((value) => value.variantId)).size > 1)
+    .map(([reference, values]) => ({ reference, variants: values }))
+    .sort((a, b) => b.variants.length - a.variants.length || a.reference.localeCompare(b.reference));
+
+  return {
+    generatedAt: new Date().toISOString(),
+    summary: {
+      missingCoreFields: missingCore.length,
+      suspiciousYears: suspiciousYears.length,
+      repeatedReferenceValues: repeatedReferences.length,
+      openConflicts: conflicts.length,
+      openReviewTasks: reviews.length,
+      importRunsWithIssues: failedRuns.length,
+    },
+    missingCore, suspiciousYears, repeatedReferences, conflicts, reviews,
+    importRunsWithIssues: failedRuns.map((run) => ({
+      id: run.id, mode: run.mode, status: run.status, scanned: run.scanned, errors: run.errors,
+      inaccessible: run.inaccessible, startedAt: run.startedAt, finishedAt: run.finishedAt,
+      cursor: run.cursor, errorSummary: run.errorSummary,
+    })),
+  };
+}
+
+export async function buildExportBundle(db: PrismaClient) {
+  const [coverage, anomalies, sourceRecords, importRuns] = await Promise.all([
+    buildCoverageReport(db), buildAnomalyReport(db),
+    db.sourceRecord.findMany({
+      orderBy: [{ sourceId: "asc" }, { externalId: "asc" }],

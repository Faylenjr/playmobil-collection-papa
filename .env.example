DATABASE_URL=postgresql://playmobil:playmobil@localhost:5432/playmobil
DIRECT_URL=postgresql://playmobil:playmobil@localhost:5432/playmobil
IMPORT_USER_AGENT=PlaymobilCollectionResearch/0.2 (+https://github.com/Faylenjr/playmobil-collection-papa; non-commercial research)
IMPORT_CONTACT_EMAIL=
IMPORT_MIN_DELAY_MS=2000
IMPORT_TIMEOUT_MS=20000
IMPORT_MAX_RETRIES=3
IMPORT_STORE_RAW=false

# Optional eBay Browse API adapter. Sandbox works with a developer keyset;
# production Buy API access must be approved by eBay before enabling imports.
EBAY_ENVIRONMENT=sandbox
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_FR
EBAY_DELIVERY_POSTAL_CODE=
EBAY_ACCOUNT_DELETION_ENDPOINT=https://playmobil.homeclap.ovh/api/ebay/account-deletion
EBAY_ACCOUNT_DELETION_VERIFICATION_TOKEN=

# Optional Kelkoo Publisher Shopping API adapter. Requires an approved
# country-specific Publisher account and JWT; no request is made when empty.
KELKOO_PUBLISHER_TOKEN=
KELKOO_COUNTRY=fr
